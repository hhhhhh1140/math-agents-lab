# Copy to .env. ./lab automatically loads this file through Docker Compose.
# Use plain values without surrounding quotes. Never commit your real key.
MATH_API_KEY=
MATH_BASE_URL=
MATH_MODEL=
# Optional per-role models for the consensus workflow. Example: keep a small
# MATH_MODEL and let a stronger model referee only the disagreements.
MATH_REFEREE_MODEL=
MATH_REASONER_MODEL=
MATH_CODER_MODEL=
# Retries for timeouts / HTTP 429 / 5xx (attempts are recorded in usage).
MATH_API_RETRIES=2
# API-only proxy. Colima can reach the Mac loopback proxy via 192.168.5.2.
# Leave blank for direct access. Never use 127.0.0.1 for the Mac from a container.
MATH_PROXY_URL=
MATH_API_TIMEOUT=120
# Enable when the provider supports response_format=json_object (e.g. SiliconFlow).
MATH_JSON_MODE=false
# Price per million tokens, in USD. Unset means cost is unknown, not zero.
MATH_INPUT_PRICE=
MATH_OUTPUT_PRICE=
MATH_CACHED_PRICE=
